ENABLE_BANKING_APP_ID=
# The application's private key (PEM contents): in double quotes over several lines, or on one
# line with \n for the line breaks
ENABLE_BANKING_PRIVATE_KEY=
# Callback URL registered with Enable Banking (default http://localhost:4321/enable-banking/callback)
ENABLE_BANKING_REDIRECT_URL=
# Directory of the persistent store (bank connections, pending authorizations; default .data).
# It holds Enable Banking session ids: keep it private.
ENABLE_BANKING_DATA_DIR=
