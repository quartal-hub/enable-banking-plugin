---
import { SKIN_URL } from "../../qrtl.config.ts";

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="stylesheet" href={SKIN_URL} />
  </head>
  <body>
    <slot />
  </body>
</html>
