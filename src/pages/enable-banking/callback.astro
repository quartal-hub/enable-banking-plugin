---
// Enable Banking redirects the user's browser here after bank authorization, with `code` and
// `state` (or `error`) in the query string. The redirect carries no bearer token: the user is the
// one who started the authorization, found through the random, single-use `state` the plugin
// created. Exchanges the code for a session and parks it as that user's new connection with the
// outcome for `getAuthorizationResult`; the user's next tool call saves it to their connection store,
// which needs the user's token. Astro escapes every value rendered below.
import {
  completeAuthorization,
  failAuthorization,
  getPendingAuthorization,
} from "../../enable-banking/AuthorizationStore.ts";
import { enableBankingRequest } from "../../enable-banking/EnableBankingClient.ts";
import { type RawAccount, toAccount } from "../../enable-banking/toAccount.ts";
import { SKIN_URL } from "../../../qrtl.config.ts";

export const prerender = false;

const params = Astro.url.searchParams;
const state = params.get("state") ?? "";
const pending = await getPendingAuthorization(state);
let title = "Unknown or expired request";
let message = "The request has expired, or the plugin was restarted. Start connecting the bank again from the chat.";
let status = 400;

if (pending) {
  const error = params.get("error");
  const code = params.get("code");
  if (error || !code) {
    const description = params.get("error_description");
    message = error ? (description ? `${error}: ${description}` : error) : "The bank returned no code.";
    title = "Bank connection was not completed";
    await failAuthorization(state, message);
  } else {
    try {
      const session = await enableBankingRequest<{
        session_id: string;
        accounts: RawAccount[];
        access?: { valid_until?: string };
      }>("POST", "/sessions", { code });
      const accounts = session.accounts.map(toAccount);
      await completeAuthorization(state, {
        uid: pending.uid,
        sessionId: session.session_id,
        bank: pending.bank,
        country: pending.country,
        psuType: pending.psuType,
        accounts,
        validUntil: session.access?.valid_until ?? pending.validUntil,
      });
      title = `${pending.bank} connected`;
      const shared = accounts.length
        ? `${accounts.length} account${accounts.length === 1 ? "" : "s"} shared.`
        : "The bank shared no accounts.";
      message = `${shared} You can close this tab and return to the chat.`;
      status = 200;
    } catch (e) {
      message = e instanceof Error ? e.message : String(e);
      title = "Bank connection failed";
      await failAuthorization(state, message);
      status = 502;
    }
  }
}
Astro.response.status = status;
Astro.response.headers.set("Cache-Control", "no-store");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="stylesheet" href={SKIN_URL} />
  </head>
  <body class="container py-5" style="max-width: 40rem">
    <h1 class="h3 mb-3">{title}</h1>
    <p>{message}</p>
  </body>
</html>
